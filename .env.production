# Production-build client configuration (public values only — never secrets).
# Loaded by Vite for `vite build` (mode=production) on Vercel and locally.
#
# Full API base of the persistent backend, INCLUDING the /api path. Must match
# the service name in render.yaml. The client fails over to same-origin /api
# (the Vercel serverless function) whenever this host is unreachable.
VITE_API_BASE_URL=https://grandforge-api.onrender.com/api
